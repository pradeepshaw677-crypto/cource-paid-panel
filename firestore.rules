rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  SMART TECH (smart-tech-d6528) — Firestore Security Rules
//  -----------------------------------------------------------------
//  Admin email set hai: smarttechbaharagora01@gmail.com
//  (wahi email js/security.js → ADMIN_EMAILS me bhi hai).
//  Agar admin email kabhi badle to DONO jagah badalna.
//
//  Ye rules hi ASLI security hain. Public web apiKey sirf wahi padh
//  sakta hai jo ye rules allow karte hain — isliye inhe Console me
//  PUBLISH karna zaroori hai, warna anonymous data padh sakta hai.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
             'smarttechbaharagora01@gmail.com'
           ];
    }

    // Student apne khud ke admission doc ka owner hai (authUid match).
    function isAdmissionOwner() {
      return signedIn()
        && resource != null
        && resource.data.authUid == request.auth.uid;
    }

    // ── Public catalogue / content: anyone may READ, only admin WRITES ──
    match /courses/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /banners/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /gallery/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /assets/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Course unlocks ───────────────────────────────────────────────
    // docId = student ka AUTH UID (email nahi). Sirf wahi student apna
    // doc padh sakta hai (uid match), enumerate koi nahi kar sakta,
    // aur likh sirf admin sakta hai.
    match /unlocked_courses/{uid} {
      allow read:  if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── Offline admissions ───────────────────────────────────────────
    // Anyone can SUBMIT an application (public form), but:
    //   • they can only create it as Pending,
    //   • they can NOT set dashboardUser / dashboardPass (no self-approve),
    // and only admin can read / approve / delete applications.
    match /offline_admissions/{id} {
      allow create: if
        ( !('status' in request.resource.data.keys())
          || request.resource.data.status == 'Pending' )
        && !('dashboardUser' in request.resource.data.keys())
        && !('dashboardPass' in request.resource.data.keys())
        && !('authUid' in request.resource.data.keys());

      // Admin sab padh sakta hai; student SIRF apna doc (authUid == uid).
      // Query where('authUid','==',uid) is rule se allow hoti hai.
      allow read: if isAdmin() || isAdmissionOwner();

      // Sirf admin approve/update/delete kar sakta hai.
      allow update, delete: if isAdmin();
    }

    // ── Default deny: nothing else is readable or writable ───────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
